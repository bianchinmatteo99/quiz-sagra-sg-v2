{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "rootDir": "src",
    "outDir": "public",
    "sourceMap": true,
    "esModuleInterop": true
  },
  "include": [
    "src/**/*"
  ]
}